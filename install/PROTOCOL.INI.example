[PROT_MAN]

   DRIVERNAME = PROTMAN$

[IBMLXCFG]

   TCPIP_NIF = TCPIP.NIF
   IWLWIFI_NIF = IWLWIFI.NIF

[TCPIP_NIF]

   DriverName = TCPIP$
   Bindings = IWLWIFI_NIF

[IWLWIFI_NIF]

   DriverName = WRND32$

   ; Your adapter's MAC (HWMAC= in the status text; IWLMAC.CMD writes it here). Recommended: TCP/IP copies the
   ; address at bind time, which can be before the firmware has run and the driver knows the real one.
   NETADDRESS = "000000000000"

   ; Optional: join only an access point on this primary channel (testing).
   ; CHANNEL = 6

   ; Optional: spatial streams to use, 1 or 2 (default 2: the adapter has two antennas). Set 1 if two-stream
   ; rates cause trouble with a particular access point.
   ; STREAMS = 1

   ; Optional: widest channel to use, 20, 40 or 80 (default 80: used when the access point (VHT) and the regulatory
   ; data allow it). Set 40 or 20 to compare.
   ; MAXWIDTH = 20

   ; Optional: receive aggregation (A-MPDU), 0 or 1 (default 1). Set 0 to compare, or if downloads stall.
   ; AMPDU = 0
   ; Optional: transmit aggregation (A-MPDU), 0 or 1 (default 1). Set 0 to compare, or if uploads stall.
   ; AGGTX = 0
   ; Optional: host rate adaptation, 0 or 1 (default 1). 0 always starts at the fastest rate (the old behaviour).
   ; RATEADAPT = 0
   ; Optional: 802.11 power save, 0 or 1 (default 0: always awake, fastest). 1 lets the adapter sleep between
   ; frames (stays awake 100 ms after each frame); saves power on a laptop, adds a little latency.
   ; POWERSAVE = 1

   ; AX200 only (all default to the values that work): the firmware's own rate scaling (AX200TLC = 1) or rates from the host
   ; (0); QoS data frames (AX200QOS = 1) or plain data frames (0); receive block-ack sessions (AX200BA = 0 off, 1 on: faster
   ; downloads, still being tested); receive buffers on the 9560 / AX200 (MQBUFS = 64, 128 or 256).
   ; AX200BA = 1
