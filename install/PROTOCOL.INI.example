[PROT_MAN]

   DRIVERNAME = PROTMAN$

[IBMLXCFG]

   TCPIP_NIF = TCPIP.NIF
   IWLWIFI_NIF = IWLWIFI.NIF

[TCPIP_NIF]

   DriverName = TCPIP$
   Bindings = IWLWIFI_NIF

[IWLWIFI_NIF]

   DriverName = WRND32$

   ; Your adapter's MAC (HWMAC= in the status text; IWLMAC.CMD writes it here). Recommended: TCP/IP copies the
   ; address at bind time, which can be before the firmware has run and the driver knows the real one.
   NETADDRESS = "000000000000"

   ; Optional: join only an access point on this primary channel (testing).
   ; CHANNEL = 6

   ; Optional: spatial streams to use, 1 or 2 (default 2: the adapter has two antennas). Set 1 if two-stream
   ; rates cause trouble with a particular access point.
   ; STREAMS = 1

   ; Optional: widest channel to use, 20 or 40 (default 40: used when the access point and the regulatory data
   ; allow it). 80 MHz is not implemented. Set 20 to compare.
   ; MAXWIDTH = 20

   ; Optional: receive aggregation (A-MPDU), 0 or 1 (default 1). Set 0 to compare, or if downloads stall.
   ; AMPDU = 0
