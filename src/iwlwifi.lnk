# SPDX-License-Identifier: GPL-2.0-only
# wlink directives for IWLWIFI.OS2 (the container of the QCA6174 and RTL88EU drivers: 16-bit NE "dll" with an
# IOPL code segment, no default libraries). hdr.obj must be first, end.obj last.
format os2 dll
name IWLWIFI.OS2
option quiet,map=IWLWIFI.map,verbose,caseexact,eliminate,nodefaultlibs
option description '@#IWLWIFI-OS2:0.0.1#@##1## 24 Nov 2026 12:00:00     ARCAOS-DEV::en:US:2:::@@Intel Wireless (iwlwifi family, 8260) PCIe WiFi driver for OS/2 and ArcaOS (GenMAC + NDIS) phase 1'
segment class 'CODE' iopl
import DOSOPEN DOSCALLS.70
import DOSCLOSE DOSCALLS.59
import DOSREAD DOSCALLS.137
import DOSDEVIOCTL DOSCALLS.53
file obj/hdr.obj
file obj/lib.obj
file obj/ndisx.obj
file obj/strat.obj
file obj/pci.obj
file obj/mem.obj
file obj/iwl_cfg.obj
file obj/iwl_fw.obj
file obj/iwl_trans.obj
file obj/iwl_mvm.obj
file obj/iwl_nvm.obj
file obj/iwl_phydb.obj
file obj/iwl_scan.obj
file obj/iwl_agg.obj
file obj/iwl_mac.obj
file obj/sta.obj
file obj/ndis.obj
file obj/genmac.obj
file obj/dbg.obj
file obj/end.obj
